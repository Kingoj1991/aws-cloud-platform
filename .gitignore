# Terraform provider downloads
.terraform/
**/.terraform/*

# Terraform state files
*.tfstate
*.tfstate.*

# Sensitive Terraform variables
*.tfvars
*.tfvars.json
*.auto.tfvars
*.auto.tfvars.json

# Environment files
.env
.env.*

# Private keys
*.pem
*.key

# Terraform crash logs
crash.log
crash.*.log

# Terraform overrides
override.tf
override.tf.json
*_override.tf
*_override.tf.json